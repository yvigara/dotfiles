{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_LSP_TOOL": "1",
    "GOPATH": "/tmp/claude/go",
    "GOTMPDIR": "/tmp/claude/go/tmp",
    "GOCACHE": "/tmp/claude/go/cache",
    "GOMODCACHE": "/tmp/claude/go/mod"
  },
  "permissions": {
    "allow": [
      "mcp__qmd__*",
      "mcp__gitnexus__*",
      "LSP",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout :*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh auth status:*)",
      "Bash(gh search:*)",
      "Bash(gh label list:*)",
      "Bash(go build:*)",
      "Bash(go generate:*)",
      "Bash(go get:*)",
      "Bash(go mod tidy:*)",
      "Bash(go run:*)",
      "Bash(go test:*)",
      "Bash(go tool:*)",
      "Bash(go version:*)",
      "Bash(golangci-lint:*)",
      "Bash(gopls version:*)",
      "Bash(gopls mcp:*)",
      "Bash(hk:*)",
      "Bash(ls:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Read(/tmp/claude/go/mod)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccline",
    "padding": 0
  },
  "enabledPlugins": {
    "memini@memini": true,
    "core@yvigara-marketplace": true,
    "beads@beads-marketplace": true,
    "gopls-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "memini": {
      "source": {
        "source": "github",
        "repo": "eleboucher/memini"
      },
      "autoUpdate": true
    },
    "yvigara-marketplace": {
      "source": {
        "source": "github",
        "repo": "yvigara/claude-plugins"
      },
      "autoUpdate": true
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "gastownhall/beads"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "*.golang.org",
        "gopkg.in",
        "*.googleapis.com",
        "anthropic.com",
        "*.anthropic.com"
      ],
      "allowUnixSockets": [
        "~/.ssh/agent-socket",
        "/private/tmp/com.apple.launchd.*/Listeners"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "/tmp/claude/go"
      ],
      "denyWrite": [
        "~/.aws",
        "~/.config",
        "~/Library/Keychains"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.authinfo.gpg",
        "~/.aws/credentials"
      ],
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.ssh/config",
        "~/.config/gh/hosts.yml"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "git",
      "docker",
      "gh",
      "kubectl"
    ]
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "agentPushNotifEnabled": true
}
